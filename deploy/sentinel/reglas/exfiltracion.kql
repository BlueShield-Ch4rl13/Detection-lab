// Generado por tools/build.py — no editar a mano
// Dominio: exfiltracion  ·  pipeline: tools/pipelines/sentinel.yml + sentinel_asim

// ─────────────────────────────────────────────────────────
// Archivado masivo previo a la exfiltracion
// Severidad: medium  ·  ATT&CK: T1074.001, T1560.001
// Origen: rules/exfiltracion/exf_001_archivado_previo_exfiltracion.yml
imProcessCreate
| where ((TargetProcessName endswith "\\rar.exe" or TargetProcessName endswith "\\winrar.exe" or TargetProcessName endswith "\\7z.exe" or TargetProcessName endswith "\\7za.exe" or TargetProcessName endswith "\\7zg.exe" or TargetProcessName endswith "\\7zr.exe" or TargetProcessName endswith "\\zip.exe" or TargetProcessName endswith "\\tar.exe" or TargetProcessName endswith "\\makecab.exe" or TargetProcessName endswith "\\wzzip.exe" or TargetProcessName endswith "\\peazip.exe") or (TargetProcessCommandLine contains "Compress-Archive" or TargetProcessCommandLine contains "System.IO.Compression.ZipFile" or TargetProcessCommandLine contains "ZipFile]::CreateFromDirectory")) and ((TargetProcessCommandLine contains " -hp" or TargetProcessCommandLine contains " -p" or TargetProcessCommandLine contains "-mhe=on" or TargetProcessCommandLine contains " -v" or TargetProcessCommandLine contains " -m5" or TargetProcessCommandLine contains " -ssw" or TargetProcessCommandLine contains " -r " or TargetProcessCommandLine contains "-t7z" or TargetProcessCommandLine contains "--password") or (TargetProcessCommandLine contains "\\Documents\\" or TargetProcessCommandLine contains "\\Desktop\\" or TargetProcessCommandLine contains "\\Downloads\\" or TargetProcessCommandLine contains "\\Users\\Public\\" or TargetProcessCommandLine contains ".pst" or TargetProcessCommandLine contains ".ost" or TargetProcessCommandLine contains ".docx" or TargetProcessCommandLine contains ".xlsx" or TargetProcessCommandLine contains ".pdf" or TargetProcessCommandLine contains ".kdbx"))

// ─────────────────────────────────────────────────────────
// Subida a almacenamiento personal en la nube
// Severidad: high  ·  ATT&CK: T1567.002
// Origen: rules/exfiltracion/exf_002_subida_nube_personal.yml
imWebSession
| where (HttpRequestMethod in~ ("POST", "PUT")) and (Url contains "content.dropboxapi.com" or Url contains "api.dropboxapi.com/2/files/upload" or Url contains "dropbox.com/upload" or Url contains "mega.nz" or Url contains "mega.io" or Url contains "api.mega.co.nz" or Url contains "wetransfer.com" or Url contains "we.tl/" or Url contains "anonfiles.com" or Url contains "gofile.io" or Url contains "pcloud.com" or Url contains "pcloud.link" or Url contains "filebin.net" or Url contains "catbox.moe" or Url contains "file.io" or Url contains "uguu.se" or Url contains "bashupload.com" or Url contains "temp.sh") and (not((Url contains ".midominio.local" or Url contains "-my.sharepoint.com")))

// ─────────────────────────────────────────────────────────
// Copia masiva de documentos a unidad extraible
// Severidad: medium  ·  ATT&CK: T1005, T1052.001
// Origen: rules/exfiltracion/exf_003_copia_masiva_extraible.yml
imFileEvent
| where (TargetFileName startswith "D:\\" or TargetFileName startswith "E:\\" or TargetFileName startswith "F:\\" or TargetFileName startswith "G:\\" or TargetFileName startswith "H:\\" or TargetFileName startswith "I:\\" or TargetFileName startswith "J:\\") and (TargetFileName endswith ".doc" or TargetFileName endswith ".docx" or TargetFileName endswith ".xls" or TargetFileName endswith ".xlsx" or TargetFileName endswith ".ppt" or TargetFileName endswith ".pptx" or TargetFileName endswith ".pdf" or TargetFileName endswith ".csv" or TargetFileName endswith ".pst" or TargetFileName endswith ".ost" or TargetFileName endswith ".zip" or TargetFileName endswith ".rar" or TargetFileName endswith ".7z" or TargetFileName endswith ".kdbx" or TargetFileName endswith ".sql" or TargetFileName endswith ".bak") and (TargetFilePath endswith "\\explorer.exe" or TargetFilePath endswith "\\cmd.exe" or TargetFilePath endswith "\\powershell.exe" or TargetFilePath endswith "\\pwsh.exe" or TargetFilePath endswith "\\robocopy.exe" or TargetFilePath endswith "\\xcopy.exe" or TargetFilePath endswith "\\7z.exe" or TargetFilePath endswith "\\rar.exe" or TargetFilePath endswith "\\winrar.exe" or TargetFilePath endswith "\\TOTALCMD64.EXE" or TargetFilePath endswith "\\FreeCommander.exe") and (not((TargetFileName contains "\\Backup\\" or TargetFileName contains "\\Veeam" or TargetFileName contains "\\WindowsImageBackup\\" or TargetFileName contains "\\System Volume Information\\" or TargetFileName contains "\\$RECYCLE.BIN\\")))

// ─────────────────────────────────────────────────────────
// Exfiltracion por protocolo alternativo
// Severidad: high  ·  ATT&CK: T1048, T1048.003
// Origen: rules/exfiltracion/exf_004_protocolo_alternativo.yml
imProcessCreate
| where ((TargetProcessName endswith "\\ping.exe" or TargetProcessName endswith "\\hping3.exe" or TargetProcessName endswith "\\nping.exe") and (TargetProcessCommandLine contains " -l 65500" or TargetProcessCommandLine contains " -l 32767" or TargetProcessCommandLine contains " -l 16384" or TargetProcessCommandLine contains " -l 8192" or TargetProcessCommandLine contains " -l 4096" or TargetProcessCommandLine contains " -l 2048" or TargetProcessCommandLine contains " -l 1472" or TargetProcessCommandLine contains " -l 1400" or TargetProcessCommandLine contains " -l 1024" or TargetProcessCommandLine contains "--data-size" or TargetProcessCommandLine contains "--data-string")) or (TargetProcessCommandLine contains "ftp -s:" or TargetProcessCommandLine contains "ftp.exe -s:" or TargetProcessCommandLine contains "ftp -n -i -s" or TargetProcessCommandLine contains "curl ftp://" or TargetProcessCommandLine contains "ftp://" or TargetProcessCommandLine contains "Net.FtpWebRequest" or TargetProcessCommandLine contains "WinSCP.com /command" or TargetProcessCommandLine contains "pscp.exe " or TargetProcessCommandLine contains "psftp.exe -b") or ((TargetProcessCommandLine contains "net use \\" or TargetProcessCommandLine contains "net.exe use \\" or TargetProcessCommandLine contains "New-PSDrive -Root \\" or TargetProcessCommandLine contains "copy \\" or TargetProcessCommandLine contains "robocopy \\") and (not((TargetProcessCommandLine contains ".midominio.local" or TargetProcessCommandLine contains "\\10." or TargetProcessCommandLine contains "\\192.168." or TargetProcessCommandLine contains "\\172.16." or TargetProcessCommandLine contains "\\172.17." or TargetProcessCommandLine contains "\\172.18." or TargetProcessCommandLine contains "\\172.19." or TargetProcessCommandLine contains "\\172.2" or TargetProcessCommandLine contains "\\172.30." or TargetProcessCommandLine contains "\\172.31." or TargetProcessCommandLine contains "\\127.0.0.1" or TargetProcessCommandLine contains "\\localhost"))))

// ─────────────────────────────────────────────────────────
// Reenvio automatico de correo a dominio personal
// Severidad: critical  ·  ATT&CK: T1020, T1114.003
// Origen: rules/exfiltracion/exf_005_reenvio_correo_personal.yml
OfficeActivity
| where (Operation in~ ("New-InboxRule", "Set-InboxRule", "UpdateInboxRules", "Set-Mailbox", "New-TransportRule", "Set-TransportRule")) and (Parameters contains "ForwardTo" or Parameters contains "RedirectTo" or Parameters contains "ForwardAsAttachmentTo" or Parameters contains "ForwardingSmtpAddress" or Parameters contains "ForwardingAddress" or Parameters contains "DeliverToMailboxAndForward") and (Parameters contains "@gmail.com" or Parameters contains "@googlemail.com" or Parameters contains "@outlook.com" or Parameters contains "@hotmail.com" or Parameters contains "@live.com" or Parameters contains "@yahoo.com" or Parameters contains "@yahoo.es" or Parameters contains "@proton.me" or Parameters contains "@protonmail.com" or Parameters contains "@icloud.com" or Parameters contains "@gmx." or Parameters contains "@mail.ru" or Parameters contains "@yandex." or Parameters contains "@tutanota.com")

// ─────────────────────────────────────────────────────────
// Subida de codigo o secretos a repositorio publico
// Severidad: high  ·  ATT&CK: T1567.001
// Origen: rules/exfiltracion/exf_006_repositorio_publico_codigo.yml
imProcessCreate
| where ((TargetProcessName endswith "\\git.exe" or TargetProcessName endswith "\\git-remote-https.exe") or TargetProcessCommandLine contains "git ") and (TargetProcessCommandLine contains " push" or TargetProcessCommandLine contains "remote add" or TargetProcessCommandLine contains "remote set-url" or TargetProcessCommandLine contains "clone --mirror" or TargetProcessCommandLine contains "bundle create") and (TargetProcessCommandLine contains "github.com" or TargetProcessCommandLine contains "gist.github.com" or TargetProcessCommandLine contains "gitlab.com" or TargetProcessCommandLine contains "bitbucket.org" or TargetProcessCommandLine contains "gitee.com" or TargetProcessCommandLine contains "codeberg.org" or TargetProcessCommandLine contains "sourceforge.net" or TargetProcessCommandLine contains "huggingface.co") and (not((TargetProcessCommandLine contains "github.midominio.local" or TargetProcessCommandLine contains "gitlab.midominio.local" or TargetProcessCommandLine contains ".midominio.local" or TargetProcessCommandLine contains "dev.azure.com/miorganizacion")))

// ─────────────────────────────────────────────────────────
// Volcado de base de datos a ruta de usuario
// Severidad: high  ·  ATT&CK: T1005, T1074.001
// Origen: rules/exfiltracion/exf_007_volcado_base_datos.yml
imProcessCreate
| where ((TargetProcessName endswith "\\mysqldump.exe" or TargetProcessName endswith "\\mysqlsh.exe" or TargetProcessName endswith "\\pg_dump.exe" or TargetProcessName endswith "\\pg_dumpall.exe" or TargetProcessName endswith "\\sqlcmd.exe" or TargetProcessName endswith "\\bcp.exe" or TargetProcessName endswith "\\expdp.exe" or TargetProcessName endswith "\\exp.exe" or TargetProcessName endswith "\\mongodump.exe" or TargetProcessName endswith "\\mongoexport.exe" or TargetProcessName endswith "\\sqlite3.exe") or (TargetProcessCommandLine contains "Invoke-Sqlcmd" or TargetProcessCommandLine contains "BACKUP DATABASE" or TargetProcessCommandLine contains "INTO OUTFILE" or TargetProcessCommandLine contains "INTO DUMPFILE" or TargetProcessCommandLine contains "COPY ( SELECT")) and (TargetProcessCommandLine contains "\\Users\\" or TargetProcessCommandLine contains "\\Desktop\\" or TargetProcessCommandLine contains "\\Downloads\\" or TargetProcessCommandLine contains "\\Documents\\" or TargetProcessCommandLine contains "\\AppData\\" or TargetProcessCommandLine contains "\\Temp\\" or TargetProcessCommandLine contains "\\ProgramData\\" or TargetProcessCommandLine contains "\\Public\\" or TargetProcessCommandLine contains "\\PerfLogs\\" or TargetProcessCommandLine contains "\\Windows\\Tasks\\") and (not((TargetProcessCommandLine contains "\\Backup\\" or TargetProcessCommandLine contains "\\dbbackup\\" or TargetProcessCommandLine contains "\\Veeam" or TargetProcessCommandLine contains "\\SQLBackups\\")))

// ─────────────────────────────────────────────────────────
// Impresion o captura masiva de documentos
// Severidad: medium  ·  ATT&CK: T1052, T1113
// Origen: rules/exfiltracion/exf_008_impresion_captura_masiva.yml
imProcessCreate
| where (((TargetProcessName endswith "\\print.exe" or (TargetProcessCommandLine contains "printui.dll,PrintUIEntry" or TargetProcessCommandLine contains "mshtml.dll,PrintHTML" or TargetProcessCommandLine contains "Out-Printer" or TargetProcessCommandLine contains "-Verb Print" or TargetProcessCommandLine contains "PrintTo")) or ((TargetProcessName endswith "\\psr.exe" or TargetProcessName endswith "\\SnippingTool.exe" or TargetProcessName endswith "\\ScreenSketch.exe") or (TargetProcessCommandLine contains "savescreenshot" or TargetProcessCommandLine contains "CopyFromScreen" or TargetProcessCommandLine contains "Graphics]::FromImage"))) and (TargetProcessCommandLine contains ".doc" or TargetProcessCommandLine contains ".xls" or TargetProcessCommandLine contains ".ppt" or TargetProcessCommandLine contains ".pdf" or TargetProcessCommandLine contains ".csv" or TargetProcessCommandLine contains "\\Documents\\" or TargetProcessCommandLine contains "\\Desktop\\" or TargetProcessCommandLine contains "\\Downloads\\" or TargetProcessCommandLine contains "/output" or TargetProcessCommandLine contains "/maxsc" or TargetProcessCommandLine contains "/d:\\")) or ((TargetProcessName endswith "\\cmd.exe" or TargetProcessName endswith "\\powershell.exe" or TargetProcessName endswith "\\pwsh.exe" or TargetProcessName endswith "\\xcopy.exe" or TargetProcessName endswith "\\robocopy.exe" or TargetProcessName endswith "\\7z.exe" or TargetProcessName endswith "\\rar.exe") and (TargetProcessCommandLine contains "\\System32\\spool\\PRINTERS" or TargetProcessCommandLine contains "\\spool\\PRINTERS\\" or TargetProcessCommandLine contains ".spl"))
