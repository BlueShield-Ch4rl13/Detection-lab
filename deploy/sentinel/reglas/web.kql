// Generado por tools/build.py — no editar a mano
// Dominio: web  ·  pipeline: tools/pipelines/sentinel.yml + sentinel_asim

// ─────────────────────────────────────────────────────────
// Inyeccion SQL en parametros de la peticion HTTP
// Severidad: high  ·  ATT&CK: T1190
// Origen: rules/web/web_001_inyeccion_sql.yml
imWebSession
| where Url contains "=" and ((Url contains "union select" or Url contains "union+select" or Url contains "union%20select" or Url contains "union all select" or Url contains "union%0aselect" or Url contains "union%23%0aselect" or Url contains "union%09select") or (Url contains "' or 1=1" or Url contains "' or '1'='1" or Url contains "') or ('1'='1" or Url contains "' or 'a'='a" or Url contains "' and 1=2" or Url contains "admin'--" or Url contains "%27%20or%201%3d1" or Url contains "%27+or+%271%27%3d%271") or (Url contains "sleep(5)" or Url contains "sleep(10)" or Url contains "pg_sleep(" or Url contains "waitfor delay" or Url contains "benchmark(10000" or Url contains "dbms_pipe.receive_message") or (Url contains "information_schema.tables" or Url contains "information_schema.columns" or Url contains "sys.databases" or Url contains "@@version" or Url contains "group_concat(" or Url contains "extractvalue(" or Url contains "updatexml(" or Url contains "load_file(" or Url contains "into outfile")) and (not((Url contains "/phpmyadmin/" or Url contains "/adminer.php" or Url contains "/pgadmin4/" or Url contains "/_sql/")))

// ─────────────────────────────────────────────────────────
// Cross-site scripting reflejado en la peticion
// Severidad: high  ·  ATT&CK: T1059.007, T1189
// Origen: rules/web/web_002_xss_reflejado.yml
imWebSession
| where (HttpStatusCode =~ "200" and (HttpRequestMethod in~ ("GET", "POST"))) and ((Url contains "<script>alert(" or Url contains "%3Cscript%3Ealert" or Url contains "\"><script" or Url contains "%22%3E%3Cscript" or Url contains "<svg/onload=" or Url contains "<svg%2Fonload" or Url contains "onerror=alert" or Url contains "onerror%3Dalert" or Url contains "javascript:alert(" or Url contains "document.location=document.cookie") or ((Url contains "<script" or Url contains "%3Cscript" or Url contains "<img" or Url contains "%3Cimg" or Url contains "<svg" or Url contains "%3Csvg" or Url contains "<iframe" or Url contains "%3Ciframe" or Url contains "<body" or Url contains "<details") and (Url contains "onerror=" or Url contains "onload=" or Url contains "onmouseover=" or Url contains "onfocus=" or Url contains "ontoggle=" or Url contains "onanimationstart=" or Url contains "javascript:" or Url contains "document.cookie" or Url contains "string.fromcharcode" or Url contains "eval(" or Url contains "fetch("))) and (not((Url contains "/wp-admin/post.php" or Url contains "/ckeditor/" or Url contains "/tinymce/" or Url contains "/admin/content/edit")))

// ─────────────────────────────────────────────────────────
// Salto de directorio hacia ficheros fuera de la raiz web
// Severidad: high  ·  ATT&CK: T1083, T1190
// Origen: rules/web/web_003_salto_de_directorio.yml
imWebSession
| where ((Url contains "../../" or Url contains "..%2f..%2f" or Url contains "%2e%2e%2f%2e%2e%2f" or Url contains "..%5c..%5c" or Url contains "%2e%2e%5c" or Url contains "....//" or Url contains "..;/" or Url contains "%c0%ae%c0%ae" or Url contains "..%c0%af" or Url contains "..%ef%bc%8f") or (Url contains "..%252f" or Url contains "%252e%252e%252f" or Url contains "..%255c" or Url contains "%25252e%25252e" or Url contains "%%32%65%%32%65") or (Url contains "/etc/passwd" or Url contains "/etc/shadow" or Url contains "/proc/self/environ" or Url contains "/proc/self/cmdline" or Url contains "/var/log/auth.log" or Url contains "/root/.ssh/id_rsa" or Url contains "/.aws/credentials" or Url contains "/wp-config.php" or Url contains "/web.config" or Url contains "\\windows\\win.ini" or Url contains "/windows/system32/drivers/etc/hosts")) and (not((Url endswith ".map" or Url endswith ".css" or Url endswith ".mjs")))

// ─────────────────────────────────────────────────────────
// Peticion falsificada desde el servidor hacia metadatos de nube
// Severidad: critical  ·  ATT&CK: T1190, T1552.005
// Origen: rules/web/web_004_ssrf_metadatos_nube.yml
imWebSession
| where (Url contains "169.254.169.254" or Url contains "metadata.google.internal" or Url contains "169.254.170.2" or Url contains "100.100.100.200" or Url contains "fd00:ec2::254" or Url contains "metadata.tencentyun.com") or (Url contains "2852039166" or Url contains "0xa9fea9fe" or Url contains "0251.0376.0251.0376" or Url contains "169.254.169.254.nip.io" or Url contains "::ffff:169.254.169.254" or Url contains "%31%36%39%2e%32%35%34%2e%31%36%39%2e%32%35%34") or (Url contains "=" and ((Url contains "latest/meta-data/iam/security-credentials" or Url contains "latest/api/token" or Url contains "latest/user-data" or Url contains "computemetadata/v1/instance/service-accounts" or Url contains "metadata/identity/oauth2/token" or Url contains "/metadata/instance" or Url contains "/metadata/v1/") or (Url contains "=file:///" or Url contains "=gopher://" or Url contains "=dict://" or Url contains "=http://127.0.0.1" or Url contains "=http://localhost" or Url contains "=http://[::1]" or Url contains "=http://0.0.0.0")))

// ─────────────────────────────────────────────────────────
// Deserializacion insegura de datos controlados por el cliente
// Severidad: critical  ·  ATT&CK: T1190
// Origen: rules/web/web_005_deserializacion_insegura.yml
imWebSession
| where (Url contains "rO0AB" or Url contains "aced0005" or Url contains "%ac%ed%00%05" or Url contains "rO0ABXNyA" or Url contains "javax.management.BadAttributeValueExpException") or (Url contains "AAEAAAD/////" or Url contains "AAEAAAD%2F%2F%2F%2F%2F" or Url contains "ObjectDataProvider" or Url contains "System.Configuration.Install.AssemblyInstaller" or Url contains "TypeConfuseDelegate" or Url contains "$type\":\"System.") or (Url contains "_$$ND_FUNC$$_" or Url contains "!ruby/object:" or Url contains "!!python/object/apply" or Url contains "!!javax.script.ScriptEngineManager" or Url contains "!!com.sun.rowset.JdbcRowSetImpl" or Url contains "c__builtin__" or Url contains "csubprocess") or (Url contains "__proto__" or Url contains "%5f%5fproto%5f%5f" or Url contains "constructor[prototype]" or Url contains "constructor%5bprototype%5d") or (Url contains "=" and (Url matches regex "O:[0-9]{1,3}:\"" or (Url contains "__destruct" or Url contains "__wakeup" or Url contains "phar://" or Url contains "a:2:{i:0;" or Url contains "O%3A8%3A%22")))

// ─────────────────────────────────────────────────────────
// Subida de fichero con extension ejecutable al directorio publicado
// Severidad: high  ·  ATT&CK: T1190, T1505.003
// Origen: rules/web/web_006_subida_fichero_ejecutable.yml
imWebSession
| where (HttpStatusCode in~ ("200", "201", "204")) and (((HttpRequestMethod in~ ("PUT", "MOVE", "COPY", "MKCOL")) and (Url endswith ".php" or Url endswith ".php3" or Url endswith ".php4" or Url endswith ".php5" or Url endswith ".php7" or Url endswith ".phtml" or Url endswith ".phar" or Url endswith ".jsp" or Url endswith ".jspx" or Url endswith ".jspf" or Url endswith ".asp" or Url endswith ".aspx" or Url endswith ".ashx" or Url endswith ".asmx" or Url endswith ".cshtml" or Url endswith ".cgi" or Url endswith ".pl" or Url endswith ".py" or Url endswith ".sh")) or (HttpRequestMethod =~ "POST" and (Url contains "/uploads/" or Url contains "/upload/" or Url contains "/wp-content/uploads/" or Url contains "/files/" or Url contains "/adjuntos/" or Url contains "/media/" or Url contains "/avatars/" or Url contains "/tmp/" or Url contains "/images/") and (Url endswith ".php" or Url endswith ".php3" or Url endswith ".php4" or Url endswith ".php5" or Url endswith ".php7" or Url endswith ".phtml" or Url endswith ".phar" or Url endswith ".jsp" or Url endswith ".jspx" or Url endswith ".jspf" or Url endswith ".asp" or Url endswith ".aspx" or Url endswith ".ashx" or Url endswith ".asmx" or Url endswith ".cshtml" or Url endswith ".cgi" or Url endswith ".pl" or Url endswith ".py" or Url endswith ".sh")) or (Url contains ".php." or Url contains ".php%00" or Url contains ".php;" or Url contains ".phtml." or Url contains ".jsp." or Url contains ".jsp%00" or Url contains ".asp;" or Url contains ".aspx;" or Url contains ".asp%00" or Url contains ".php%20"))

// ─────────────────────────────────────────────────────────
// Inyeccion de comandos del sistema operativo en un parametro
// Severidad: high  ·  ATT&CK: T1059.004, T1190
// Origen: rules/web/web_007_inyeccion_de_comandos.yml
imWebSession
| where Url contains "=" and (Url contains ";" or Url contains "%3b" or Url contains "|" or Url contains "%7c" or Url contains "&&" or Url contains "%26%26" or Url contains "$(" or Url contains "%24%28" or Url contains "%60" or Url contains "%0a" or Url contains "%0d%0a" or Url contains "%0asleep") and (Url contains "whoami" or Url contains "uname -a" or Url contains "uname%20-a" or Url contains "cat /etc/passwd" or Url contains "cat%20/etc/passwd" or Url contains "/bin/sh" or Url contains "/bin/bash" or Url contains "bash -c" or Url contains "bash%20-c" or Url contains "wget " or Url contains "wget%20" or Url contains "curl -" or Url contains "curl%20-" or Url contains "nc -e" or Url contains "nc%20-e" or Url contains "ping -c" or Url contains "ping%20-c" or Url contains "nslookup " or Url contains "certutil" or Url contains "powershell" or Url contains "base64 -d" or Url contains "base64%20-d" or Url contains "chmod +x" or Url contains "chmod%20%2bx") and (not((Url contains "/admin/tools/ping" or Url contains "/diagnostics/traceroute" or Url contains "/nagios/cgi-bin/")))

// ─────────────────────────────────────────────────────────
// Inyeccion JNDI en peticion HTTP tipo Log4Shell
// Severidad: critical  ·  ATT&CK: T1059, T1190
// Origen: rules/web/web_008_inyeccion_jndi_log4shell.yml
imWebSession
| where (Url contains "${jndi:" or Url contains "%24%7bjndi" or Url contains "%2524%257bjndi" or Url contains "jndi%3aldap" or Url contains "%6a%6e%64%69%3a" or Url contains "${lower:j}" or Url contains "${upper:j}" or Url contains "${::-j}" or Url contains "${${") or (HttpUserAgent contains "${jndi:" or HttpUserAgent contains "%24%7bjndi" or HttpUserAgent contains "jndi%3aldap" or HttpUserAgent contains "%6a%6e%64%69%3a" or HttpUserAgent contains "${lower:j}" or HttpUserAgent contains "${upper:j}" or HttpUserAgent contains "${::-j}" or HttpUserAgent contains "${${") or (HttpReferrer contains "${jndi:" or HttpReferrer contains "%24%7bjndi" or HttpReferrer contains "jndi%3aldap" or HttpReferrer contains "${lower:j}" or HttpReferrer contains "${::-j}" or HttpReferrer contains "${${")

// ─────────────────────────────────────────────────────────
// Contrabando de peticiones HTTP entre proxy y servidor final
// Severidad: high  ·  ATT&CK: T1190
// Origen: rules/web/web_009_contrabando_peticiones.yml
imWebSession
| where ((Url contains "content-length:" or Url contains "transfer-encoding:" or Url contains "content-length%3a" or Url contains "transfer-encoding%3a" or Url contains "transfer-encoding%20%3a" or Url contains "te:%20chunked" or Url contains "chunked%0d%0a") or (Url contains "%0d%0a" or Url contains "%0a%0d" or Url contains "%250d%250a" or Url contains "%00%0d%0a" or Url contains "%e5%98%8a%e5%98%8d")) or ((HttpStatusCode in~ ("400", "408", "501")) and (not((HttpRequestMethod in~ ("GET", "POST", "HEAD", "PUT", "DELETE", "OPTIONS", "PATCH", "CONNECT", "TRACE", "PROPFIND", "PROPPATCH", "MKCOL", "COPY", "MOVE", "LOCK", "UNLOCK")))))

// ─────────────────────────────────────────────────────────
// Escaneo automatizado del servidor web por herramienta conocida
// Severidad: medium  ·  ATT&CK: T1595.002, T1595.003
// Origen: rules/web/web_010_escaneo_automatizado.yml
imWebSession
| where ((HttpUserAgent contains "sqlmap/" or HttpUserAgent contains "nikto" or HttpUserAgent contains "nuclei" or HttpUserAgent contains "feroxbuster" or HttpUserAgent contains "gobuster" or HttpUserAgent contains "dirbuster" or HttpUserAgent contains "dirsearch" or HttpUserAgent contains "wfuzz" or HttpUserAgent contains "ffuf" or HttpUserAgent contains "wpscan" or HttpUserAgent contains "acunetix" or HttpUserAgent contains "nessus" or HttpUserAgent contains "openvas" or HttpUserAgent contains "zgrab" or HttpUserAgent contains "masscan" or HttpUserAgent contains "nmap scripting engine" or HttpUserAgent contains "zaproxy" or HttpUserAgent contains "arachni" or HttpUserAgent contains "whatweb" or HttpUserAgent contains "commix") or ((HttpUserAgent in~ ("-", "")) and HttpStatusCode =~ "404")) and (not((HttpUserAgent contains "googlebot" or HttpUserAgent contains "bingbot" or HttpUserAgent contains "applebot" or HttpUserAgent contains "duckduckbot" or HttpUserAgent contains "uptimerobot" or HttpUserAgent contains "pingdom" or HttpUserAgent contains "statuscake" or HttpUserAgent contains "ahrefsbot")))

// ─────────────────────────────────────────────────────────
// Abuso de token JWT con algoritmo nulo o cabecera manipulada
// Severidad: high  ·  ATT&CK: T1550.001, T1606
// Origen: rules/web/web_011_abuso_de_token_jwt.yml
imWebSession
| where (((Url contains "eyJhbGciOiJub25l" or Url contains "eyJhbGciOiJOb25l" or Url contains "eyJhbGciOiJOT05F" or Url contains "eyJhbGciOiJuT25F" or Url contains "eyJ0eXAiOiJKV1QiLCJhbGciOiJub25l") or (Url contains "eyJhbGciOiJIUzI1NiIsImtpZCI6Ii4u" or Url contains "eyJhbGciOiJSUzI1NiIsImprdSI6Imh0" or Url contains "eyJhbGciOiJSUzI1NiIsIng1dSI6Imh0")) or (Url contains "\"alg\":\"none\"" or Url contains "%22alg%22%3a%22none%22" or Url contains "alg=none" or Url contains "algorithm=none") or ((Url contains "eyJ" or Url contains "token=" or Url contains "jwt=" or Url contains "access_token=" or Url contains "id_token=") and (Url contains "kid=../" or Url contains "kid=..%2f" or Url contains "kid=/dev/null" or Url contains "kid=/etc/passwd" or Url contains "jku=http" or Url contains "x5u=http"))) and (not((Url contains "/.well-known/jwks.json" or Url contains "/swagger-ui" or Url contains "/api-docs")))

// ─────────────────────────────────────────────────────────
// Shell lanzada por el proceso del servidor web tras explotacion
// Severidad: critical  ·  ATT&CK: T1059.004, T1190, T1505.003
// Origen: rules/web/web_012_shell_tras_explotacion.yml
imProcessCreate
| where ((ParentProcessName contains "/nginx" or ParentProcessName contains "/apache2" or ParentProcessName contains "/httpd" or ParentProcessName contains "/php-fpm" or ParentProcessName contains "/php-cgi" or ParentProcessName contains "/lighttpd" or ParentProcessName contains "/caddy" or ParentProcessName contains "/uwsgi" or ParentProcessName contains "/gunicorn" or ParentProcessName contains "/puma" or ParentProcessName contains "/unicorn") or (ActingProcessName contains "/nginx" or ActingProcessName contains "/apache2" or ActingProcessName contains "/httpd" or ActingProcessName contains "/php-fpm" or ActingProcessName contains "/php-cgi" or ActingProcessName contains "/lighttpd" or ActingProcessName contains "/caddy" or ActingProcessName contains "/uwsgi" or ActingProcessName contains "/gunicorn" or ActingProcessName contains "/puma" or ActingProcessName contains "/unicorn")) and ((TargetProcessName endswith "/nc" or TargetProcessName endswith "/ncat" or TargetProcessName endswith "/netcat" or TargetProcessName endswith "/socat" or TargetProcessName endswith "/telnet" or TargetProcessName endswith "/nmap" or TargetProcessName endswith "/ssh") or ((TargetProcessName endswith "/bash" or TargetProcessName endswith "/sh" or TargetProcessName endswith "/dash" or TargetProcessName endswith "/zsh" or TargetProcessName endswith "/ksh" or TargetProcessName endswith "/python" or TargetProcessName endswith "/python3" or TargetProcessName endswith "/perl" or TargetProcessName endswith "/ruby" or TargetProcessName endswith "/lua") and ((TargetProcessCommandLine contains "/dev/tcp/" or TargetProcessCommandLine contains "/dev/udp/" or TargetProcessCommandLine contains "bash -i" or TargetProcessCommandLine contains "sh -i" or TargetProcessCommandLine contains "mkfifo" or TargetProcessCommandLine contains "rm /tmp/f" or TargetProcessCommandLine contains "pty.spawn" or TargetProcessCommandLine contains "import socket" or TargetProcessCommandLine contains "setsid" or TargetProcessCommandLine contains "script -qc") or (TargetProcessCommandLine contains "whoami" or TargetProcessCommandLine contains "uname -a" or TargetProcessCommandLine contains "id -u" or TargetProcessCommandLine contains "/etc/passwd" or TargetProcessCommandLine contains "/etc/shadow" or TargetProcessCommandLine contains "crontab -l" or TargetProcessCommandLine contains "sudo -l" or TargetProcessCommandLine contains "curl http" or TargetProcessCommandLine contains "wget http" or TargetProcessCommandLine contains "chmod +x" or TargetProcessCommandLine contains "base64 -d" or TargetProcessCommandLine contains "history -c")))) and (not((TargetProcessCommandLine contains "/usr/sbin/sendmail" or TargetProcessCommandLine contains "/usr/bin/ffmpeg" or TargetProcessCommandLine contains "/usr/bin/gs " or TargetProcessCommandLine contains "wp-cron.php" or TargetProcessCommandLine contains "artisan schedule:run" or TargetProcessCommandLine contains "artisan queue:work" or TargetProcessCommandLine contains "/usr/sbin/logrotate" or TargetProcessCommandLine contains "newrelic-daemon")))

